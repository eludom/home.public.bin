#!/bin/bash
# List gnome keyboard shortcuts
#
# https://askubuntu.com/questions/725611/how-to-search-through-all-keyboard-shortcuts-that-use-a-certain-key

set -e -u  # This is bash.  Be safe.

echo GNOME SHORTCUTS WITH BINDINGS
gsettings list-recursively | awk '/hotkey/||/keybinding/||/media-key/'| grep -v -E \\[..\\]\|\\[\\]

echo GNOME SHORTCUTS WITHOUT BINDINGS
gsettings list-recursively | awk '/hotkey/||/keybinding/||/media-key/'| grep -E \\[..\\]\|\\[\\]
