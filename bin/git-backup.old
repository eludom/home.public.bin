#!/usr/bin/env bash
# Autocommit files in specified git dirs, log results
# 
# Copyright (C) 2026 George Jones 
#
# Author: George Jones <gmj@pobox.com>
# Assisted-by: deepseek/deepseek-v4-flash-0731
# Maintainer: George Jones <gmj@pobox.com>
# URL: 
# Version: 0.1

set -euo pipefail

CONFIG_FILE="$HOME/etc/backup/gitdirs.txt"
LOG_DIR="$HOME/var/log"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
LOG_FILE="$LOG_DIR/git_backup_${TIMESTAMP}.log"

DRY_RUN=false
VERBOSE=false

usage() {
    echo "Usage: $0 [OPTIONS]"
    echo "Options:"
    echo "  -n, --dry-run  Show what would be done without making changes"
    echo "  -v, --verbose  Output log messages to stdout as well as logfile"
    echo "  -h, --help     Display this help message"
    exit 0
}

# Parse command line flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--dry-run) DRY_RUN=true; shift ;;
        -v|--verbose) VERBOSE=true; shift ;;
        -h|--help) usage ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
done

# Logging function
log() {
    local msg="$1"
    echo -e "$msg" >> "$LOG_FILE"
    if $VERBOSE; then
        echo -e "$msg"
    fi
}

# Ensure log directory exists
mkdir -p "$LOG_DIR"
log "=== Git Backup Started: $(date) ==="
if $DRY_RUN; then log "*** DRY RUN MODE ENABLED ***"; fi

if [[ ! -f "$CONFIG_FILE" ]]; then
    log "ERROR: Config file not found at $CONFIG_FILE"
    exit 1
fi

# Process directories
while IFS= read -r dir || [[ -n "$dir" ]]; do
    # Skip empty lines and comments
    [[ -z "$dir" || "$dir" =~ ^[[:space:]]*# ]] && continue

    # Expand tilde if present
    dir="${dir/#\~/$HOME}"

    log "\n----------------------------------------"
    log "Processing: $dir"
    log "----------------------------------------"

    if [[ ! -d "$dir" ]]; then
        log "WARNING: Directory does not exist. Skipping."
        continue
    fi

    # Subshell to handle cd safely
    (
        cd "$dir" || exit 1

        if ! git rev-parse --is-inside-work-tree &>/dev/null; then
            log "WARNING: $dir is not a valid git repository. Skipping."
            exit 0
        fi

        # 1. Report untracked .org files
        untracked_org=$(git ls-files --others --exclude-standard '*.org')
        if [[ -n "$untracked_org" ]]; then
            log "[UNTRACKED .ORG FILES]:"
            log "$untracked_org"
        else
            log "[UNTRACKED .ORG FILES]: None"
        fi

        # 2. Check for modified tracked files
        if git diff --quiet && git diff --cached --quiet; then
            log "No modified tracked files to commit."
            exit 0
        fi

        log "[MODIFIED FILES DETECTED]"
	git status --short --untracked-files=no >> "$LOG_FILE"
        if $VERBOSE; then git status --short --untracked-files=no; fi

        # 3. Add modified files and commit
        if $DRY_RUN; then
            log "[DRY-RUN] Would execute: git add -u"
            log "[DRY-RUN] Would execute: git commit -m 'Auto-backup: $(date)'"
        else
            log "Running: git add -u"
            add_output=$(git add -u 2>&1)
            [[ -n "$add_output" ]] && log "$add_output"

            log "Running: git commit..."
            commit_output=$(git commit -m "Auto-backup: $(date +'%Y-%m-%d %H:%M:%S')" 2>&1)
            log "$commit_output"
        fi
    )

done < "$CONFIG_FILE"

log "\n=== Backup Finished: $(date) ==="
log "Log saved to: $LOG_FILE"
info "Log saved to: $LOG_FILE" 

Add a function "info" to log messages to stderr.  Add a few more info logging messages to show progress and number of untracked files.  Also add a --silent (or similar) option to supresupress these messages.

Also add an option to add untracked files.  Output the whole modified script below

``` reasoning
**Implementing Logging and Silence**

I'm currently focused on integrating enhanced logging capabilities, specifically an `info` function to output progress and file counts to stderr. Simultaneously, I'm developing a `--silent` option to allow users to suppress these informational messages, providing more control over output verbosity.

**Adding File Staging Options**

I'm now expanding the functionality to include staging untracked files with a new `--add-untracked` flag. This complements the existing silent mode and will offer greater flexibility in managing repository changes. I'm also refining the `info` function for more detailed progress reporting.

**Processing Git Add Logic**

My focus has shifted to refining the `git add` logic. I'm implementing conditional behavior based on the `--add-untracked` flag, opting for `git add .` or `git add -A` when it's enabled, and `git add -u` otherwise. I'm also ensuring the CLI parser accurately handles new options and integrating `info` calls effectively.

**Refining Argument Parsing**

I'm currently refining the command-line argument parsing logic. The `info` function is now conditional on the `SILENT` flag, ensuring output only appears when not in silent mode. I'm also working on the logic for conditionally staging untracked files based on the `--add-untracked` flag.


```

Here is the complete updated script:

```bash
#!/usr/bin/env bash
# Autocommit files in specified git dirs, log results
# Copyright (C) 2026 George Jones 
#
# Author: George Jones <gmj@pobox.com>
# Assisted-by: deepseek/deepseek-v4-flash-0731
# Maintainer: George Jones <gmj@pobox.com>
# URL: 
# Version: 0.2

set -euo pipefail

CONFIG_FILE="$HOME/etc/backup/gitdirs.txt"
LOG_DIR="$HOME/var/log"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
LOG_FILE="$LOG_DIR/git_backup_${TIMESTAMP}.log"

ADD_UNTRACKED=false
DRY_RUN=false
SILENT=false
VERBOSE=false

usage() {
    echo "Usage: $0 [OPTIONS]"
    echo "Options:"
    echo "  -a, --add-untracked  Include untracked files in the commit"
    echo "  -n, --dry-run        Show what would be done without making changes"
    echo "  -s, --silent         Suppress progress messages sent to stderr"
    echo "  -v, --verbose        Output log messages to stdout as well as logfile"
    echo "  -h, --help           Display this help message"
    exit 0
}

# Parse command line flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        -a|--add-untracked) ADD_UNTRACKED=true; shift ;;
        -n|--dry-run) DRY_RUN=true; shift ;;
        -s|--silent|-q|--quiet) SILENT=true; shift ;;
        -v|--verbose) VERBOSE=true; shift ;;
        -h|--help) usage ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# Logging function for logfile (and optionally stdout)
log() {
    local msg="$1"
    echo -e "$msg" >> "$LOG_FILE"
    if $VERBOSE; then
        echo -e "$msg"
    fi
}

# Informational messages output to stderr unless suppressed
info() {
    local msg="$1"
    if ! $SILENT; then
        echo -e "$msg" >&2
    fi
}

# Ensure log directory exists
mkdir -p "$LOG_DIR"
info "Starting git autocommit backup script..."
log "=== Git Backup Started: $(date) ==="
if $DRY_RUN; then log "*** DRY RUN MODE ENABLED ***"; fi
if $ADD_UNTRACKED; then log "*** INCLUDE UNTRACKED FILES ENABLED ***"; fi

if [[ ! -f "$CONFIG_FILE" ]]; then
    msg="ERROR: Config file not found at $CONFIG_FILE"
    log "$msg"
    info "$msg"
    exit 1
fi

info "Reading repositories from $CONFIG_FILE"

# Process directories
while IFS= read -r dir || [[ -n "$dir" ]]; do
    # Skip empty lines and comments
    [[ -z "$dir" || "$dir" =~ ^[[:space:]]*# ]] && continue

    # Expand tilde if present
    dir="${dir/#\~/$HOME}"

    info "Processing: $dir"
    log "\n----------------------------------------"
    log "Processing: $dir"
    log "----------------------------------------"

    if [[ ! -d "$dir" ]]; then
        msg="WARNING: Directory $dir does not exist. Skipping."
        log "$msg"
        info "$msg"
        continue
    fi

    # Subshell to handle cd safely
    (
        cd "$dir" || exit 1

        if ! git rev-parse --is-inside-work-tree &>/dev/null; then
            msg="WARNING: $dir is not a valid git repository. Skipping."
            log "$msg"
            info "$msg"
            exit 0
        fi

        # 1. Report untracked files
        untracked_org=$(git ls-files --others --exclude-standard '*.org')
        untracked_all=$(git ls-files --others --exclude-standard)
        
        org_count=0
        [[ -n "$untracked_org" ]] && org_count=$(echo "$untracked_org" | wc -l | tr -d ' ')
        
        all_count=0
        [[ -n "$untracked_all" ]] && all_count=$(echo "$untracked_all" | wc -l | tr -d ' ')

        info "Found $org_count untracked .org file(s) ($all_count total untracked file(s))"

        if [[ -n "$untracked_org" ]]; then
            log "[UNTRACKED .ORG FILES]:"
            log "$untracked_org"
        else
            log "[UNTRACKED .ORG FILES]: None"
        fi

        # Determine git add strategy
        ADD_CMD="git add -u"
        if $ADD_UNTRACKED; then
            ADD_CMD="git add -A"
        fi

        # 2. Check for changes based on the selected mode
        has_changes=false
        if $ADD_UNTRACKED; then
            if [[ -n $(git status --porcelain) ]]; then
                has_changes=true
            fi
        else
            if ! git diff --quiet || ! git diff --cached --quiet; then
                has_changes=true
            fi
        fi

        if ! $has_changes; then
            log "No matching changes to commit."
            info "No changes to commit in $dir."
            exit 0
        fi

        log "[CHANGES DETECTED]"
        status_opts="--short"
        if ! $ADD_UNTRACKED; then status_opts="$status_opts --untracked-files=no"; fi
        
        git status $status_opts >> "$LOG_FILE"
        if $VERBOSE; then git status $status_opts; fi

        # 3. Add files and commit
        if $DRY_RUN; then
            log "[DRY-RUN] Would execute: $ADD_CMD"
            log "[DRY-RUN] Would execute: git commit -m 'Auto-backup: $(date)'"
            info "[DRY-RUN] Skipped committing changes for $dir"
        else
            info "Committing changes in $dir..."
            log "Running: $ADD_CMD"
            add_output=$($ADD_CMD 2>&1)
            [[ -n "$add_output" ]] && log "$add_output"

            log "Running: git commit..."
            commit_output=$(git commit -m "Auto-backup: $(date +'%Y-%m-%d %H:%M:%S')" 2>&1)
            log "$commit_output"
            info "Successfully committed changes in $dir"
        fi
    )

done < "$CONFIG_FILE"

log "\n=== Backup Finished: $(date) ==="
log "Log saved to: $LOG_FILE"
info "Backup process finished. Log saved to: $LOG_FILE"
```
