#!/bin/bash
# Show actions needed for a list of git directories
#
# Usage: gitcheck [DIR [DIR]]
#

set -e; set -u

# Helper functions
PROG=`basename "$0" | tr -d '\n'`

function info()  { echo `date +%c` ${PROG}\: info: "$@" 1>&2; }
function warn()  { echo `date +%c` ${PROG}\: warning: "$@" 1>&2; }
function error() { echo `date +%c` ${PROG}\: error: "$@" 1>&2; }
function debug() { [[ -v DEBUG ]] && echo `date +%c` ${PROG}\: debug: "$@" 1>&2 || true ; }
function die()   { echo `date +%c` ${PROG}\: fatal: "$@" 1>&2 && exit 1; }

function isGitPushOrPullNeeded() {
    # Show if git push or pull is needed to upstream
    #
    # Source: http://stackoverflow.com/questions/3258243/git-check-if-pull-needed
    #

    git fetch --all

    LOCAL=$(git rev-parse @)
    REMOTE=$(git rev-parse @{u})
    BASE=$(git merge-base @ @{u})

    if [ $LOCAL = $REMOTE ]; then
        info "Up-to-date (LOCAL $LOCAL = REMOTE $REMOTE)"
    elif [ $LOCAL = $BASE ]; then
        info "Need to pull (LOCAL $LOCAL = BASE $BASE)"
    elif [ $REMOTE = $BASE ]; then
        info "Need to push (REMOTE $REMOTE = BASE $BASE)"
    else
        info "Diverged"
    fi

}

function gitChecks() {
    # Perform various checks of status of git in currenct directory
    # Show any actions needed
    
    DIR=${1:-`pwd`} # get directory name

    if [ ! -d "$DIR/.git" ]; then
        warn "$DIR is not a git repo.  Skipping."
        echo
        return
    fi
    
    pushd ${DIR} > /dev/null # go there
    info "Checking ${DIR}"
    
    isGitPushOrPullNeeded
    echo
    
    info git status for $DIR
    git status .
    echo
    
    popd > /dev/null # back to original directory
}



ARGC=$#  # Number of args, not counting $0

i=1  # Used as argument index
while true; do

    DIR=${1:-""}
    
    if [ "$DIR" ]; then
        gitChecks "$DIR"
  	shift
     else
   	break # Stop loop when no more args.
     fi
     i=$((i+1))
done

echo
info "Done."



